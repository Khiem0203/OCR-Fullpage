# Chép thành .env rồi điền; không commit giá trị thật.

# Truy cập
# Danh sách API key, cách nhau bằng dấu phẩy
API_KEYS=
# Chỉ dùng khi dev: tắt xác thực
AUTH_DISABLED=false
# Bật /docs (tắt khi chạy thật)
ENABLE_DOCS=false
CORS_ORIGINS=
# Host callback_url được phép; trống = mọi host
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRIES=3

# RabbitMQ / PostgreSQL
CELERY_BROKER_URL=amqp://user:password@localhost:5672//
CELERY_RESULT_BACKEND=db+postgresql://user:password@localhost:5432/celery_results
# Trống = không lưu kết quả vào DB
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=fullpage
POSTGRES_USER=fullpage
POSTGRES_PASSWORD=
RESULT_EXPIRES=86400

# S3 / MinIO (mặc định khi request không gửi khóa)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Dùng https khi S3_ENDPOINT không ghi http/https
S3_SSL=false

# Chandra OCR (vLLM)
# Tên hoặc đường dẫn model
CHANDRA_MODEL=datalab-to/chandra-ocr-2
# Trống = không cần key
CHANDRA_API_KEY=
CHANDRA_URL=http://localhost:8101/v1/chat/completions
# Số token tối đa cho 1 trang
CHANDRA_MAX_TOKENS=4096
CHANDRA_TIMEOUT=300
# Số trang gửi cùng lúc
OCR_CONCURRENCY=4
# Card GPU (vd 0, 1, 0,1)
CHANDRA_CUDA_DEVICE=0
# Phải khớp cổng trong CHANDRA_URL
CHANDRA_PORT=8101
CHANDRA_MAX_MODEL_LEN=6000
# Tỉ lệ VRAM được dùng (0-1)
CHANDRA_GPU_MEMORY_UTILIZATION=0.95
CHANDRA_MAX_NUM_BATCHED_TOKENS=9216
CHANDRA_MAX_NUM_SEQS=20
CHANDRA_PREFIX_CACHING=true
# Cờ vllm thêm, vd --enforce-eager
CHANDRA_VLLM_EXTRA_ARGS=

# ProtonX sửa chính tả
SPELLFIX_API_URL=http://localhost:8006/spellfix/correct
SPELLFIX_TIMEOUT=300
SPELLFIX_CONCURRENCY=2
SPELLFIX_MODEL=protonx-models/protonx-legal-tc
# Card GPU
SPELLFIX_CUDA_DEVICE=1
# float32 hoặc bfloat16 (không dùng float16)
SPELLFIX_DTYPE=float32
SPELLFIX_NUM_BEAMS=4
SPELLFIX_MAX_TOKENS=160
SPELLFIX_BATCH_SIZE=16
# Bỏ kết quả nếu độ dài lệch ngoài khoảng này
SPELLFIX_MIN_LEN_RATIO=0.8
SPELLFIX_MAX_LEN_RATIO=1.25

# Trang
RENDER_DPI=200
MAX_LONG_SIDE=1536
DESKEW=true
MAX_PAGES=100
MAX_UPLOAD_MB=50
# Chandra lỗi thì dùng text có sẵn trong PDF (chỉ khi lớp text không lỗi)
PDF_TEXT_FALLBACK=true

# File đầu vào
# Ưu tiên lấy text từ docx/doc/odt/rtf/txt/md có sẵn, không dùng được mới OCR
TEXT_FIRST=true
# Chỉ định 1 file thì lấy thêm file cùng tên khác đuôi trong cùng thư mục
INPUT_SIBLINGS=true
# Text không có ngắt trang thì chia trang ảo khoảng chừng này ký tự
TEXT_PAGE_CHARS=3000
# Sửa chính tả cả text lấy từ file văn bản (mặc định chỉ sửa text OCR)
SPELL_TEXT_FILES=false
# Lấy text PDF trực tiếp; 1 trang lỗi Unicode là OCR cả file
PDF_TEXT_FIRST=true
# Tỉ lệ từ có trong từ điển tối thiểu (cả file) để dùng text PDF
PDF_TEXT_MIN_KNOWN=0.9

# Từ điển và chính tả
DICTIONARY_DIR=data/dictionaries
DICTIONARIES=hongocduc,tudientv,wiktionary
# off: tắt | dict: chỉ từ điển | both: ProtonX + từ điển
SPELL_MODE=both
# suspects: chỉ dòng có từ lạ | all: mọi dòng (chậm hơn)
SPELL_REVIEW=suspects
SPELL_BATCH_CHARS=1800
# Từ riêng coi là đúng, mỗi dòng một từ
EXTRA_WORDS_FILE=
# CSV sai,dung áp dụng trước
REPLACEMENTS_FILE=

# Báo từ lạ
UNKNOWN_REPORT=true
UNKNOWN_INCLUDE=vietnamese,foreign,acronym
UNKNOWN_MIN_LEN=2
UNKNOWN_MAX_WORDS=200

# Flower
# user:password (bắt buộc, Flower hiện cả khóa S3)
FLOWER_BASIC_AUTH=
FLOWER_URL=http://localhost:5555

# start-service.sh
API_PORT=9090
PREPARE_WORKERS=2
OCR_WORKERS=2
SPELL_WORKERS=2
DB_WORKERS=2
START_FLOWER=false
# Bật Chandra (cần vllm trong venv)
START_CHANDRA=false
# Bật ProtonX (cần requirements-spellfix.txt)
START_SPELLFIX=false
